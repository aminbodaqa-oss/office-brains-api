# AI provider: demo, ollama, or gemini
BRAIN_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90

# Private owner-only access
OWNER_USERNAME=choose-a-private-username
# Generate with: python -c "from auth import hash_password; print(hash_password('YOUR_PASSWORD'))"
OWNER_PASSWORD_HASH=
# Generate a random value of at least 32 characters; keep it server-side only.
OFFICE_AUTH_SECRET=
OFFICE_TOKEN_TTL_SECONDS=1800

# Server-to-server Vindora connection
VINDORA_API_URL=https://vindora.whf.bz
VINDORA_API_KEY=
VINDORA_TIMEOUT=12

DATABASE_PATH=./data/office_brains.sqlite3
CORS_ORIGINS=https://aminbodaqa-oss.github.io
