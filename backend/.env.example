# demo = setup message; ollama = self-hosted model; gemini = Google Gemini API
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required to encrypt API keys saved from the Super Admin dashboard.
PLATFORM_SECRETS_KEY=
BRAIN_PROVIDER=demo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90

# Private owner-only access
OWNER_USERNAME=choose-a-private-username
# Generate with: python -c "from getpass import getpass; from auth import hash_password; print(hash_password(getpass('New password: ')))"
OWNER_PASSWORD_HASH=
# Generate a random value of at least 32 characters; keep it server-side only.
OFFICE_AUTH_SECRET=
OFFICE_TOKEN_TTL_SECONDS=1800

# Tenant sessions use a separate signing secret and audience from owner sessions.
# Customer login remains disabled until tenant data isolation is complete.
TENANT_AUTH_SECRET=
TENANT_TOKEN_TTL_SECONDS=3600


DATABASE_PATH=./data/office_brains.sqlite3
CORS_ORIGINS=https://aminbodaqa-oss.github.io,http://localhost:8000,http://127.0.0.1:5500

# Autonomous daily office kickoff (Sunday-Thursday at 09:00 Cairo time)
AUTONOMOUS_OFFICE_ENABLED=false
