{
  "expo": {
    "name": "Vindora Office",
    "slug": "vindora-office",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "vindoraoffice",
    "android": {
      "package": "com.vindora.office",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11172E"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#11172E",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#11172E"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://9ywu5lapwb.apps.bot-hosting.cloud",
      "eas": {
        "projectId": "0a298a2b-154a-4918-b8a5-352666a362ed"
      }
    },
    "owner": "vindora_eg",
    "icon": "./assets/icon.png"
  }
}
